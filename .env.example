# MindBridge-AIOps 环境配置示例
# 复制为 .env 后按需填写；不配 LLM Key 时系统走规则降级，仍可运行

# DeepSeek API Key（智能分析主模型）
DEEPSEEK_API_KEY=

# Kimi (Moonshot) API Key —— 智能问答使用
# 申请: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=
KIMI_CHAT_MODEL=kimi-k2.6

# 长期记忆后端：mysql 或 sqlite（MySQL 不可用时自动降级回 sqlite）
LONG_TERM_BACKEND=mysql
MYSQL_DSN=mysql://root:123456@localhost:3306/aiopsAgent

# 会话归档保留天数：超过该天数的历史会话移入归档表，0=不归档
CHAT_ARCHIVE_DAYS=7

# 预警发送 Webhook：非空则真实 POST 到该地址，否则仅写入 notifications 表
NOTIFICATION_WEBHOOK_URL=
